# Copy to .env and adjust. .env is gitignored.

# Directory holding the three unzipped Coveo CSVs (browsing_train.csv,
# search_train.csv, sku_to_content.csv). Obtain them yourself from Coveo --
# see docs/DATA_ACCESS.md. Forward slashes work on Windows.
COVEO_RAW_DIR=C:/data/coveo-sigir/SIGIR-ecom-data-challenge/train

# Heavy artefacts (the DuckDB warehouse + spill files) live OUTSIDE the repo.
# The repo is inside a OneDrive-synced folder, and a multi-GB database there
# would be uploaded on every write. Point this anywhere with free disk.
COVEO_WORK_DIR=C:/data/coveo-sigir/work

# DuckDB filename, resolved inside COVEO_WORK_DIR (or an absolute path).
DUCKDB_PATH=coveo.duckdb

# PostgreSQL serving layer (holds the compact modeled marts only)
PGHOST=localhost
PGPORT=5432
PGDATABASE=coveo_analytics
PGUSER=postgres
PGPASSWORD=

# Sampling: fraction of sessions to use while developing the pipeline.
# 1.0 = full 36M events. Start small, scale up.
SAMPLE_SESSION_FRACTION=0.01
